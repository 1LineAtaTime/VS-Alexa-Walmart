[Unit]
Description=Amazon to Walmart Shopping List Automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Configured to run as root user with project at /home/VS-Alexa-Walmart
User=root
WorkingDirectory=/home/VS-Alexa-Walmart
Environment="PATH=/home/VS-Alexa-Walmart/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DISPLAY=:99"
ExecStartPre=/usr/bin/git -C /home/VS-Alexa-Walmart pull
# xvfb-run provides a virtual display for non-headless Chrome (required for PerimeterX bypass)
ExecStart=/usr/bin/xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24' /home/VS-Alexa-Walmart/.venv/bin/python src/main.py

# Restart policy
Restart=always
RestartSec=10

# Memory limit to prevent runaway browser processes
MemoryMax=2G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amazon-walmart-automation

# Security settings (optional but recommended)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
